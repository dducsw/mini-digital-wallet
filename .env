# Application Server Settings
SERVER_PORT=8080
GRPC_PORT=9090
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Local Docker Mapped Port: 5436)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=ledger_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Redis Cache & Idempotency Lock Configuration (Local Docker Mapped Port: 6381)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# Docker Compose Exposed Ports
DOCKER_POSTGRES_PORT=5436
DOCKER_REDIS_PORT=6381
