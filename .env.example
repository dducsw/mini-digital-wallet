# Application Server Settings
SERVER_PORT=8080
GRPC_PORT=9090
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Local Docker Mapped Port: 5436)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=wallet_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Docker Compose Exposed Ports
DOCKER_POSTGRES_PORT=5436

# JWT Auth (REQUIRED for app startup; 64+ hex chars = 256 bit)
# Generate: openssl rand -hex 32
APP_JWT_SECRET=change-me-64-hex-chars-minimum-0000000000000000000000000000
# Token lifetime in ms (access 15 min default; refresh 7 days default)
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
